# OpenRouter credentials
OPENROUTER_API_KEY=PASTE_YOUR_API_KEY_HERE

# Exact OpenRouter model identifier
OPENROUTER_MODEL=

# OpenRouter API endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Request settings
PVB_API_CONCURRENCY=5
PVB_API_MAX_RETRIES=3
PVB_API_TIMEOUT_SECONDS=90

# Cost controls
PVB_API_MAX_COST_USD=2.00

# Classification settings
PVB_CLASSIFICATION_TEMPERATURE=0
PVB_CLASSIFICATION_MAX_OUTPUT_TOKENS=8192
PVB_CLASSIFICATION_REASONING_ENABLED=false

# Optional GapGPT backend (separate key; never reuses OPENROUTER_API_KEY)
GAPGPT_API_KEY=
GAPGPT_MODEL=gpt-5.6-terra
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_CONCURRENCY=2
GAPGPT_TIMEOUT_SECONDS=180
GAPGPT_REASONING_EFFORT=medium
GAPGPT_CONTEXT_LIMIT_TOKENS=32768

# Only needed if the gateway catalog omits supported USD pricing.
# Use verified GapGPT rates and their source, not native OpenAI list prices.
GAPGPT_INPUT_USD_PER_MILLION=
GAPGPT_OUTPUT_USD_PER_MILLION=
GAPGPT_REQUEST_USD=
GAPGPT_PRICING_SOURCE=

# === Three benchmark language variants: English / LLM Persian / Google Persian ===
# Includes all 54 samples: unsafe_violence + other_violence; preserves source metadata.
PVB_TRANSLATION_INPUT=runs/gapgpt/pvb-gap-621566036e034163884561aaf26d655d/all54_categorized_samples.jsonl
PVB_TRANSLATION_OUTPUT=runs/translation
PVB_TRANSLATION_SCOPE=all
PVB_TRANSLATION_SOURCE_LANGUAGE=en
PVB_TRANSLATION_TARGET_LANGUAGE=fa
PVB_TRANSLATION_MAX_COST_USD=2.00

# 1) English: original text; no translation key needed.

# 2) LLM -> Persian. Edit provider/model here to record the exact translator type.
# Reuses the existing GAPGPT_API_KEY above; never paste that key into this variable.
PVB_TRANSLATION_LLM_PROVIDER=gapgpt
PVB_TRANSLATION_LLM_MODEL=gpt-5.6-terra
PVB_TRANSLATION_LLM_BASE_URL=https://api.gapgpt.app/v1
PVB_TRANSLATION_LLM_CREDENTIAL_ENV=GAPGPT_API_KEY

# 3) Google -> Persian. FILL THIS with your Google Cloud Translation API key.
# Enable Cloud Translation API and billing in the key's Google Cloud project.
# Basic v2 with NMT is distinct from the LLM translation variant above.
GOOGLE_TRANSLATE_API_KEY=
PVB_GOOGLE_TRANSLATE_EDITION=basic_v2
PVB_GOOGLE_TRANSLATE_MODEL=nmt

# Local Google TranslateGemma 4B (separate from Google Cloud Translation API).
# Accept Gemma access terms, then place a read-only Hugging Face token here.
HF_TOKEN=
PVB_TRANSLATEGEMMA_MODEL_PATH=models/translategemma-4b
PVB_TRANSLATEGEMMA_REVISION=main
PVB_TRANSLATEGEMMA_MAX_INPUT_TOKENS=2048
PVB_TRANSLATEGEMMA_MAX_NEW_TOKENS=512
# Free GPU/RAM is measured at load time; CPU offload may be slow.
PVB_TRANSLATEGEMMA_ALLOW_CPU_OFFLOAD=false
PVB_TRANSLATEGEMMA_GPU_RESERVE_MIB=256
